{
  "unstable": ["kv"],
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv --watch src/index.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --unstable-kv src/index.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "lint": {
    "exclude": ["frontend"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "exclude": ["frontend"],
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"]
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.6.0",
    "hono/": "jsr:/@hono/hono@^4.6.0/"
  },
  "deploy": {
    "org": "dandibbert",
    "app": "pixvel"
  }
}
